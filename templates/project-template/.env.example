# {{PROJECT_NAME}} Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Application Settings
APP_NAME={{PROJECT_FOLDER_NAME}}
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-secret-key-here

# Runtime/Platform Configuration (set based on selected stack)
RUNTIME_VERSION=
SERVICE_BASE_URL=

# Data Configuration (optional)
DATABASE_CONNECTION_STRING=
CACHE_CONNECTION_STRING=

# Secrets and Key Management (optional)
SECRETS_PROVIDER=
SECRETS_REFERENCE=

# Observability (optional)
LOG_LEVEL=info
OBSERVABILITY_ENDPOINT=
TRACE_SAMPLING_RATE=0.1

# External Services
# Add your API keys and service endpoints here

# Feature Flags
FEATURE_NEW_UI=false
